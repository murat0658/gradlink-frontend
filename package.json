{
  "name": "gradlink",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "lsof -ti:19000 | xargs kill -9 2>/dev/null || true; lsof -ti:19001 | xargs kill -9 2>/dev/null || true; expo start --clear",
    "clean": "lsof -ti:19000 | xargs kill -9 2>/dev/null || true; lsof -ti:19001 | xargs kill -9 2>/dev/null || true; rm -rf node_modules/.cache .expo .expo-shared && expo start --clear",
    "kill": "lsof -ti:19000 | xargs kill -9 2>/dev/null || true; lsof -ti:19001 | xargs kill -9 2>/dev/null || true",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.26",
    "@reduxjs/toolkit": "^2.11.2",
    "expo": "~54.0.31",
    "expo-constants": "^18.0.13",
    "expo-device": "^8.0.8",
    "expo-font": "~14.0.10",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.21",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@react-native-community/cli": "^20.0.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
